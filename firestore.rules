rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects collection: Public can view published projects without authentication.
    // Admin / authenticated users can create, update, and delete projects.
    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    // Packages collection: Public can view packages and custom prices without authentication.
    // Admin / authenticated users can create, update, and delete packages.
    match /packages/{packageId} {
      allow read: if true;
      allow write: if true;
    }

    // Packages v2: a single document (packages_v2/current) holding the live package list.
    // Separate from the legacy "packages" collection that older site versions keep overwriting.
    match /packages_v2/{docId} {
      allow read: if true;
      allow write: if true;
    }

    // User activity and real-time presence tracking
    match /user_activity/{userId} {
      allow read, write: if true;
    }

    match /activity_events/{eventId} {
      allow read, write: if true;
    }

    // Client inquiries (appointments, quotes, enquiries, package bookings).
    // Open like the other collections because the admin console also signs in with built-in
    // founder credentials (no Firebase account), so rules cannot tell the admin apart.
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
